{
  "name": "lm15",
  "version": "1.0.0-alpha.0",
  "description": "One canonical request/response model over OpenAI, Anthropic, Gemini and every OpenAI-compatible server. Zero dependencies. Built against the lm15-contract corpus.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/cjs/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/cjs/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lm15-vet": "./dist/vet.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run surface && rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && npm run build:examples && npm run python:wheel && npm run rust:wasm",
    "check": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit && tsc -p tsconfig.providers.json --noEmit",
    "test": "node --experimental-strip-types --experimental-vm-modules --test tests/*.test.ts",
    "vet": "node dist/vet.js",
    "surface": "node --experimental-strip-types tools/gen_surface.ts",
    "differential": "python3 tools/differential.py && python3 tools/differential_surfaces.py",
    "harness": "cd ../lm15-contract && python3 harness/check.py --shim typescript --direction all",
    "test:browser": "node --experimental-strip-types tools/browser_smoke.ts",
    "build:examples": "tsc -p tsconfig.examples.json && tsc -p tsconfig.providers.json",
    "example": "node --experimental-strip-types tools/provider_demo.ts --open",
    "example:local": "node --experimental-strip-types tools/provider_demo.ts --local-keys --open",
    "example:openrouter": "node --experimental-strip-types tools/serve.ts examples/openrouter-page/",
    "test:providers": "npm run build && node --experimental-strip-types --test tools/provider_ui.test.ts",
    "pretest:example": "npm run build && npm run test:example:ui",
    "test:example": "node --experimental-strip-types tools/example_smoke.ts",
    "test:example:ui": "node --experimental-strip-types --test tools/example_ui.test.ts",
    "python:wheel": "node --experimental-strip-types tools/python_wheel.ts",
    "rust:wasm": "node --experimental-strip-types tools/rust_wasm.ts",
    "rust:snippets": "node --experimental-strip-types tools/rust_snippets.ts"
  },
  "keywords": [
    "ai",
    "anthropic",
    "browser",
    "electron",
    "gemini",
    "llm",
    "lm15",
    "openai",
    "pwa",
    "universal"
  ],
  "author": "lm15-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lm15-dev/lm15-ts.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "playwright-core": "^1.63.0",
    "pyodide": "^0.29.3",
    "typescript": "^5.9"
  }
}
