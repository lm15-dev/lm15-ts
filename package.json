{
  "name": "lm15",
  "version": "1.0.0-rc.1",
  "description": "One canonical request/response model over OpenAI, Anthropic, Gemini and every OpenAI-compatible server. Zero dependencies. Built against the lm15-contract corpus.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "require": "./dist/cjs/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/cjs/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tls",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:typescript",
    "build:tls": "cd tls && rcargo build --release && mkdir -p ../vendor/tls && cp target/wasm32v1-none/release/lm15_tls.wasm ../vendor/tls/lm15-tls.wasm",
    "build:typescript": "npm run surface && rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && cp src/auth/native_lock.cjs dist/auth/native_lock.cjs && cp src/auth/native_lock.cjs dist/cjs/auth/native_lock.cjs && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && (test ! -f vendor/tls/lm15-tls.wasm || (mkdir -p dist/tls && cp vendor/tls/lm15-tls.wasm dist/tls/lm15-tls.wasm)) && npm run build:examples",
    "check": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "node --experimental-strip-types --experimental-vm-modules --test tests/*.test.ts",
    "vet": "node dist/vet.js",
    "surface": "node --experimental-strip-types tools/gen_surface.ts",
    "differential": "python3 tools/differential.py && python3 tools/differential_surfaces.py",
    "harness": "cd ../lm15-contract && python3 harness/check.py --shim typescript --direction all",
    "test:browser": "node --experimental-strip-types tools/browser_smoke.ts",
    "build:examples": "tsc -p tsconfig.examples.json",
    "example:openrouter": "node --experimental-strip-types tools/serve.ts examples/openrouter-page/",
    "pretest:example": "npm run build && npm run test:example:ui",
    "test:example": "node --experimental-strip-types tools/example_smoke.ts",
    "test:example:ui": "node --experimental-strip-types --test tools/example_ui.test.ts",
    "prepublishOnly": "npm run check && npm run build && npm test"
  },
  "keywords": [
    "ai",
    "anthropic",
    "browser",
    "electron",
    "gemini",
    "llm",
    "lm15",
    "openai",
    "pwa",
    "universal"
  ],
  "author": "lm15-dev",
  "license": "MIT",
  "homepage": "https://lm15.dev",
  "bugs": {
    "url": "https://github.com/lm15-dev/lm15-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lm15-dev/lm15-ts.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
